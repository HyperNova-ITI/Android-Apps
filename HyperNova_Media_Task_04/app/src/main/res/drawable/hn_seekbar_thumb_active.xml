<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center">

        <shape android:shape="oval">
            <solid android:color="#2600DDF4" />
        </shape>
    </item>

    <item
        android:width="17dp"
        android:height="17dp"
        android:gravity="center">

        <shape android:shape="oval">
            <solid android:color="#071821" />

            <stroke
                android:width="2dp"
                android:color="#31E5F7" />
        </shape>
    </item>

    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="center">

        <shape android:shape="oval">
            <solid android:color="#A4F8FF" />
        </shape>
    </item>

</layer-list>
