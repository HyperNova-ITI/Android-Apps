<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.HyperNovaMedia" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hn_cyan</item>
        <item name="colorOnPrimary">@color/hn_on_cyan</item>
        <item name="colorSecondary">@color/hn_violet</item>
        <item name="colorSurface">@color/hn_surface</item>
        <item name="colorOnSurface">@color/hn_text_primary</item>
        <item name="colorSurfaceVariant">@color/hn_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/hn_text_secondary</item>
        <item name="colorOutline">@color/hn_border</item>
        <item name="colorError">@color/hn_error</item>
        <item name="android:windowBackground">@color/hn_background</item>
        <item name="android:navigationBarColor">@color/hn_background</item>
        <item name="android:statusBarColor">@color/hn_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.HyperNovaMedia" parent="Base.Theme.HyperNovaMedia" />

    <style name="Text.HyperNova.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/hn_cyan</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.HyperNova.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/hn_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="Text.HyperNova.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/hn_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.HyperNova.Action" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/hn_cyan</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/hn_cyan</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/hn_transparent</item>
    </style>
    <style name="Widget.HyperNova.Chip" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">68dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/hn_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/hn_surface_high</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
