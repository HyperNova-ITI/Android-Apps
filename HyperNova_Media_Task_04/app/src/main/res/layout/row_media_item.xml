<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card" android:clickable="true" android:focusable="true"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
    <ImageView android:id="@+id/row_icon" android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="@null" android:src="@drawable/ic_music" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/hn_text_primary" android:textSize="15sp" />
        <TextView android:id="@+id/row_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/hn_text_secondary" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/row_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/hn_text_muted" android:textSize="11sp" />
</LinearLayout>
