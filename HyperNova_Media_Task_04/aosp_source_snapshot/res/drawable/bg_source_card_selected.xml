<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_pressed" />
            <stroke
                android:width="2dp"
                android:color="@color/hypernova_cyan_pressed" />
            <corners android:radius="@dimen/hn_small_card_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_selected" />
            <stroke
                android:width="2dp"
                android:color="@color/hypernova_cyan" />
            <corners android:radius="@dimen/hn_small_card_radius" />
        </shape>
    </item>

</selector>
