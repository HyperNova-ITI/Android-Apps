<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:showIn="@layout/activity_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchDestinationButton"
            style="@style/Widget.HyperNova.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:contentDescription="@string/search_destination"
            android:gravity="start|center_vertical"
            android:text="@string/search_destination"
            android:textSize="15sp"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconTint="@color/hypernova_cyan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeButton"
                style="@style/Widget.HyperNova.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/home_content_description"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:text="@string/home"
                android:textSize="12sp"
                tools:text="Home&#10;Sheikh Zayed"
                app:icon="@drawable/ic_home"
                app:iconPadding="8dp"
                app:iconTint="@color/hypernova_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/workButton"
                style="@style/Widget.HyperNova.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/work_content_description"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:text="@string/work"
                android:textSize="12sp"
                tools:text="Work&#10;Valeo"
                app:icon="@drawable/ic_work"
                app:iconPadding="8dp"
                app:iconTint="@color/hypernova_cyan" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fuelButton"
                style="@style/Widget.HyperNova.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/fuel_content_description"
                android:gravity="start|center_vertical"
                android:text="@string/fuel"
                android:textSize="12sp"
                app:icon="@drawable/ic_fuel"
                app:iconPadding="8dp"
                app:iconTint="@color/hypernova_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recentButton"
                style="@style/Widget.HyperNova.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/recent_content_description"
                android:gravity="start|center_vertical"
                android:text="@string/recent"
                android:textSize="12sp"
                app:icon="@drawable/ic_recent"
                app:iconPadding="8dp"
                app:iconTint="@color/hypernova_cyan" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.HyperNova.Card.Compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_destinations"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    tools:layout_height="96dp" />

                <TextView
                    android:id="@+id/noRecentsText"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="@string/no_recent_destinations"
                    android:textColor="@color/hypernova_text_disabled"
                    android:textSize="12sp"
                    tools:text="Cairo University" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.HyperNova.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_status"
                android:textColor="@color/hypernova_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/routeStatusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/no_active_route"
                android:textColor="@color/hypernova_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Cairo University" />

            <TextView
                android:id="@+id/routeStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/no_active_route_detail"
                android:textColor="@color/hypernova_text_secondary"
                android:textSize="11sp"
                tools:text="31 min • 23 km" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primarySearchButton"
                style="@style/Widget.HyperNova.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/search_destination"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart"
                app:iconTint="@color/hypernova_on_cyan" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
