<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/hypernova_overlay"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/hypernova_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_content_description"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="@color/hypernova_text_primary" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_navigation"
            app:tint="@color/hypernova_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/navigation_title"
                android:textColor="@color/hypernova_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="ROUTE PREVIEW" />

            <TextView
                android:id="@+id/originStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="@string/iti_start_status"
                android:textColor="@color/hypernova_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/networkStatusText"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:minWidth="56dp"
            android:text="@string/online_label"
            android:textColor="@color/hypernova_success"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="OFFLINE" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@color/hypernova_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="19:28" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
