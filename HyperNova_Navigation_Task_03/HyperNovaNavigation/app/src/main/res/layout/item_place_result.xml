<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resultCard"
    style="@style/Widget.HyperNova.Card.Compact"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginBottom="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/hypernova_card_elevated"
    app:rippleColor="@color/hypernova_selected">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_place"
            app:tint="@color/hypernova_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hypernova_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Smart Village" />

            <TextView
                android:id="@+id/categoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hypernova_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Food • cafe" />

            <TextView
                android:id="@+id/addressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hypernova_text_secondary"
                android:textSize="11sp"
                tools:text="Sheikh Zayed, Giza, Egypt" />

            <TextView
                android:id="@+id/distanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hypernova_text_disabled"
                android:textSize="11sp"
                tools:text="Straight-line • 3.4 km" />

        </LinearLayout>

        <ImageView
            android:id="@+id/selectionIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_success"
            android:visibility="invisible"
            app:tint="@color/hypernova_cyan"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
