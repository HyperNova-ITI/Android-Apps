<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.HyperNovaNavigation"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand colors -->
        <item name="colorPrimary">@color/hypernova_cyan</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/hypernova_cyan_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Application surfaces -->
        <item name="colorSurface">@color/hypernova_card</item>
        <item name="colorOnSurface">@color/hypernova_text_primary</item>

        <item name="colorSurfaceVariant">@color/hypernova_card_elevated</item>
        <item name="colorOnSurfaceVariant">@color/hypernova_text_secondary</item>

        <!-- Application window -->
        <item name="android:windowBackground">@color/hypernova_background</item>
        <item name="android:colorAccent">@color/hypernova_cyan</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/hypernova_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/hypernova_background</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Android 12+ splash screen -->
        <item name="android:windowSplashScreenBackground">
            @color/hypernova_background
        </item>

        <item name="android:windowSplashScreenAnimatedIcon">
            @drawable/ic_navigation_splash
        </item>

        <item name="android:windowSplashScreenIconBackgroundColor">
            @color/hypernova_card
        </item>

    </style>

</resources>