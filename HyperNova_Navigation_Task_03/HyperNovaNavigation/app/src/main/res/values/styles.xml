<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Widget.HyperNova.Button.Primary"
        parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hypernova_on_cyan</item>
        <item name="backgroundTint">@color/hypernova_cyan</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style
        name="Widget.HyperNova.Button.Secondary"
        parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/hypernova_text_primary</item>
        <item name="backgroundTint">@color/hypernova_card</item>
        <item name="strokeColor">@color/hypernova_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style
        name="Widget.HyperNova.Button.Danger"
        parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/hypernova_error</item>
        <item name="backgroundTint">@color/hypernova_card</item>
        <item name="strokeColor">@color/hypernova_error</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style
        name="Widget.HyperNova.Card"
        parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/hypernova_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/hypernova_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style
        name="Widget.HyperNova.Card.Compact"
        parent="Widget.HyperNova.Card">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

</resources>
