<?xml version="1.0" encoding="utf-8"?>
<!--
    HyperNova Climate Home (README §13 hierarchy).

    Every top-level section height is 0dp + a layout_weight equal to its share of
    the approved reference (941x1672). Because the whole screen is proportional,
    it matches the reference at ANY device density (160/240/320) and always fills
    the panel — the zones+car block stays the dominant ~40%.

    tools:* values are design-time preview only; runtime renders from
    confirmedState (no dummy data — README §5).

    Section weights (≈ reference proportions):
      header 46 · environment 62 · zones+car 350 · health 40 · power 78 ·
      fan 60 · airflow 92 · defrost 56 · seats 56 · confirmation 26
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/hn_screen_margin"
    android:paddingTop="@dimen/hn_space_8"
    android:paddingBottom="@dimen/hn_space_8"
    tools:background="@drawable/bg_screen"
    tools:layout_width="540dp"
    tools:layout_height="960dp">

    <!-- ============================ HEADER ============================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hn_header_height"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/hn_touch_min"
            android:layout_height="@dimen/hn_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/hn_text_primary"
            android:scaleType="centerInside"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/tvClimateTitle"
            style="@style/HnText.AppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hn_space_8"
            android:text="@string/climate_title" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvClimateMode"
            style="@style/HnText.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hn_primary_cyan"
            tools:text="@string/mode_auto" />

        <View
            android:id="@+id/viewClimateStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/hn_space_8"
            android:background="@drawable/bg_status_dot" />

        <TextClock
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hn_space_8"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/hn_text_primary"
            android:textSize="13sp"
            tools:text="19:28" />
    </LinearLayout>

    <!-- ==================== ENVIRONMENT STATUS CARD ==================== -->
    <LinearLayout
        android:id="@+id/cardEnvironment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hn_status_card_height"
        android:layout_marginTop="@dimen/hn_space_8"
        android:orientation="horizontal"
        android:background="@drawable/bg_card"
        android:padding="@dimen/hn_space_12"
        android:baselineAligned="false">

        <!-- Cabin -->
        <LinearLayout
            android:id="@+id/cabinEnvironmentSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/hn_icon_small"
                    android:layout_height="@dimen/hn_icon_small"
                    android:src="@drawable/ic_thermostat"
                    app:tint="@color/hn_primary_cyan"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/HnText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hn_space_4"
                    android:text="@string/label_cabin_temp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCabinTemperature"
                style="@style/HnText.EnvValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hn_space_4"
                tools:text="25.0°C" />
        </LinearLayout>

        <View
            android:id="@+id/airQualityDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/hn_border_subtle" />

        <!-- Air quality -->
        <LinearLayout
            android:id="@+id/airQualityEnvironmentSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/hn_icon_small"
                    android:layout_height="@dimen/hn_icon_small"
                    android:src="@drawable/ic_eco"
                    app:tint="@color/hn_success"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/HnText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hn_space_4"
                    android:text="@string/label_air_quality" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAirQuality"
                style="@style/HnText.EnvValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hn_space_4"
                android:textColor="@color/hn_success"
                tools:text="@string/air_quality_good" />
        </LinearLayout>

        <View
            android:id="@+id/outsideTemperatureDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/hn_border_subtle" />

        <!-- Outside -->
        <LinearLayout
            android:id="@+id/outsideEnvironmentSection"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/hn_icon_small"
                    android:layout_height="@dimen/hn_icon_small"
                    android:src="@drawable/ic_weather"
                    app:tint="@color/hn_text_secondary"
                    android:contentDescription="@null" />
                <TextView
                    style="@style/HnText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hn_space_4"
                    android:text="@string/label_outside_temp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOutsideTemperature"
                style="@style/HnText.EnvValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hn_space_4"
                tools:text="28.0°C" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ ZONES + CENTRAL VEHICLE VISUALIZATION ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hn_section_gap"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Driver zone -->
        <LinearLayout
            android:id="@+id/cardDriverZone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_driver"
            android:orientation="vertical"
            android:padding="@dimen/hn_space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/hn_icon_small"
                    android:layout_height="@dimen/hn_icon_small"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_seat"
                    app:tint="@color/hn_primary_cyan" />

                <TextView
                    android:id="@+id/tvDriverZoneTitle"
                    style="@style/HnText.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hn_space_4"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:text="@string/zone_driver"
                    android:textSize="14sp"
                    android:textColor="@color/hn_primary_cyan" />
            </LinearLayout>

            <!-- 5-row centered column: face, feet, both, gauge, +/- -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/hn_space_4"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                tools:ignore="TouchTargetSizeCheck">

                <ImageButton
                    android:id="@+id/driverAirflowOption1"
                    android:layout_width="@dimen/hn_airflow_w"
                    android:layout_height="@dimen/hn_airflow_h"
                    android:background="@drawable/bg_control_selected"
                    android:contentDescription="@string/cd_airflow_face"
                    android:padding="@dimen/hn_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/car_fan_mid_left_24px"
                    app:tint="@color/hn_primary_cyan" />

                <ImageButton
                    android:id="@+id/driverAirflowOption2"
                    android:layout_width="@dimen/hn_airflow_w"
                    android:layout_height="@dimen/hn_airflow_h"
                    android:layout_marginTop="@dimen/hn_space_8"
                    android:background="@drawable/bg_control_toggle"
                    android:contentDescription="@string/cd_airflow_feet"
                    android:padding="@dimen/hn_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/car_fan_low_left_24px"
                    app:tint="@color/hn_text_secondary" />

                <ImageButton
                    android:id="@+id/driverAirflowOption3"
                    android:layout_width="@dimen/hn_airflow_w"
                    android:layout_height="@dimen/hn_airflow_h"
                    android:layout_marginTop="@dimen/hn_space_8"
                    android:background="@drawable/bg_control_toggle"
                    android:contentDescription="@string/cd_airflow_face_feet"
                    android:padding="@dimen/hn_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/car_fan_low_mid_left_24px"
                    app:tint="@color/hn_text_secondary" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hn_gauge_size"
                    android:layout_marginTop="@dimen/hn_space_12">

                    <com.hypernova.climate.ui.view.TemperatureGaugeView
                        android:id="@+id/driverTemperatureArc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:gaugeAccentColor="@color/hn_primary_cyan"
                        app:gaugeStrokeWidth="@dimen/hn_gauge_stroke" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDriverTargetTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/hn_primary_cyan"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            tools:text="22.0°C" />

                        <TextView
                            style="@style/HnText.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/label_target" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hn_space_12"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnDriverTemperatureMinus"
                        style="@style/HnTempButton"
                        android:layout_width="50dp"
                        android:contentDescription="@string/cd_temp_minus"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/hn_text_primary" />

                    <ImageButton
                        android:id="@+id/btnDriverTemperaturePlus"
                        style="@style/HnTempButton"
                        android:layout_width="50dp"
                        android:layout_marginStart="@dimen/hn_space_12"
                        android:contentDescription="@string/cd_temp_plus"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/hn_primary_cyan" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Central vehicle visualization: dark render + airflow overlay. -->
        <FrameLayout
            android:layout_width="@dimen/hn_vehicle_width"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/hn_space_4">

            <ImageView
                android:id="@+id/ivVehicleVisualization"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_vehicle_stage"
                android:clipToOutline="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/vehicle_top_theme" />

            <com.hypernova.climate.ui.view.CabinAirflowView
                android:id="@+id/airflowView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Passenger zone -->
        <LinearLayout
            android:id="@+id/cardPassengerZone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_passenger"
            android:orientation="vertical"
            android:padding="@dimen/hn_space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPassengerZoneTitle"
                    style="@style/HnText.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/zone_passenger"
                    android:textSize="14sp"
                    android:textColor="@color/hn_warning" />

                <ImageView
                    android:layout_width="@dimen/hn_icon_small"
                    android:layout_height="@dimen/hn_icon_small"
                    android:layout_marginStart="@dimen/hn_space_4"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_seat"
                    app:tint="@color/hn_warning" />
            </LinearLayout>

            <!-- 5-row centered column: face, feet, both, gauge, +/- -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/hn_space_4"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                tools:ignore="TouchTargetSizeCheck">

                <ImageButton
                    android:id="@+id/passengerAirflowOption1"
                    android:layout_width="@dimen/hn_airflow_w"
                    android:layout_height="@dimen/hn_airflow_h"
                    android:background="@drawable/bg_control_selected_amber"
                    android:contentDescription="@string/cd_airflow_face"
                    android:padding="@dimen/hn_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/car_fan_mid_right_24px"
                    app:tint="@color/hn_warning" />

                <ImageButton
                    android:id="@+id/passengerAirflowOption2"
                    android:layout_width="@dimen/hn_airflow_w"
                    android:layout_height="@dimen/hn_airflow_h"
                    android:layout_marginTop="@dimen/hn_space_8"
                    android:background="@drawable/bg_control_toggle"
                    android:contentDescription="@string/cd_airflow_feet"
                    android:padding="@dimen/hn_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/car_fan_low_right_24px"
                    app:tint="@color/hn_text_secondary" />

                <ImageButton
                    android:id="@+id/passengerAirflowOption3"
                    android:layout_width="@dimen/hn_airflow_w"
                    android:layout_height="@dimen/hn_airflow_h"
                    android:layout_marginTop="@dimen/hn_space_8"
                    android:background="@drawable/bg_control_toggle"
                    android:contentDescription="@string/cd_airflow_face_feet"
                    android:padding="@dimen/hn_space_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/car_fan_mid_low_right_24px"
                    app:tint="@color/hn_text_secondary" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hn_gauge_size"
                    android:layout_marginTop="@dimen/hn_space_12">

                    <com.hypernova.climate.ui.view.TemperatureGaugeView
                        android:id="@+id/passengerTemperatureArc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:gaugeAccentColor="@color/hn_warning"
                        app:gaugeStrokeWidth="@dimen/hn_gauge_stroke" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPassengerTargetTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/hn_warning"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            tools:text="24.0°C" />

                        <TextView
                            style="@style/HnText.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/label_target" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hn_space_12"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPassengerTemperatureMinus"
                        style="@style/HnTempButton"
                        android:layout_width="50dp"
                        android:contentDescription="@string/cd_temp_minus"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/hn_text_primary" />

                    <ImageButton
                        android:id="@+id/btnPassengerTemperaturePlus"
                        style="@style/HnTempButton"
                        android:layout_width="50dp"
                        android:layout_marginStart="@dimen/hn_space_12"
                        android:contentDescription="@string/cd_temp_plus"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/hn_warning" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== PRIMARY CONTROLS ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hn_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingVertical="@dimen/hn_space_12"
        android:paddingHorizontal="@dimen/hn_space_8"
        android:baselineAligned="false">

        <LinearLayout style="@style/HnPrimaryColumn">
            <ImageButton
                android:id="@+id/btnClimatePower"
                style="@style/HnControlButton"
                android:background="@drawable/bg_control_selected"
                android:src="@drawable/ic_power"
                app:tint="@color/hn_primary_cyan"
                android:contentDescription="@string/control_power" />
            <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/hn_space_4"
                android:text="@string/control_power" />
        </LinearLayout>

        <LinearLayout style="@style/HnPrimaryColumn">
            <ImageButton
                android:id="@+id/btnClimateAuto"
                style="@style/HnControlButton"
                android:background="@drawable/bg_control_selected"
                android:src="@drawable/ic_auto"
                app:tint="@color/hn_primary_cyan"
                android:contentDescription="@string/control_auto" />
            <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/hn_space_4"
                android:text="@string/control_auto" />
        </LinearLayout>

        <LinearLayout style="@style/HnPrimaryColumn">
            <ImageButton
                android:id="@+id/btnClimateAc"
                style="@style/HnControlButton"
                android:background="@drawable/bg_control_selected"
                android:src="@drawable/ic_ac"
                app:tint="@color/hn_primary_cyan"
                android:contentDescription="@string/control_ac" />
            <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/hn_space_4"
                android:text="@string/control_ac" />
        </LinearLayout>

        <!-- Divider between A/C and SYNC -->
        <View
            android:id="@+id/primaryControlsDivider"
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="@dimen/hn_space_4"
            android:background="@color/hn_border_subtle" />

        <LinearLayout style="@style/HnPrimaryColumn">
            <ImageButton
                android:id="@+id/btnClimateSync"
                style="@style/HnControlButton"
                android:src="@drawable/ic_sync"
                app:tint="@color/hn_text_secondary"
                android:contentDescription="@string/control_sync" />
            <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/hn_space_4"
                android:text="@string/control_sync" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================= FAN SPEED ========================= -->
    <LinearLayout
        android:id="@+id/fanSpeedSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hn_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingVertical="@dimen/hn_space_8"
        android:paddingHorizontal="@dimen/hn_space_12">

        <ImageView
            android:layout_width="@dimen/hn_icon_medium"
            android:layout_height="@dimen/hn_icon_medium"
            android:src="@drawable/ic_fan"
            app:tint="@color/hn_primary_cyan"
            android:contentDescription="@string/label_fan_speed" />

        <ImageButton
            android:id="@+id/btnFanMinus"
            style="@style/HnControlButton"
            android:layout_marginStart="@dimen/hn_space_12"
            android:src="@drawable/ic_minus"
            app:tint="@color/hn_text_primary"
            android:contentDescription="@string/cd_fan_minus" />

        <LinearLayout
            android:id="@+id/fanLevelIndicator"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/hn_space_12"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1"
                android:layout_marginEnd="3dp" android:background="@drawable/bg_seg_on" />
            <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1"
                android:layout_marginEnd="3dp" android:background="@drawable/bg_seg_on" />
            <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1"
                android:layout_marginEnd="3dp" android:background="@drawable/bg_seg_on" />
            <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1"
                android:layout_marginEnd="3dp" android:background="@drawable/bg_seg_off" />
            <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1"
                android:background="@drawable/bg_seg_off" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFanLevel"
            style="@style/HnText.EnvValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="20dp"
            android:gravity="center"
            tools:text="3" />

        <ImageButton
            android:id="@+id/btnFanPlus"
            style="@style/HnControlButton"
            android:layout_marginStart="@dimen/hn_space_12"
            android:src="@drawable/ic_plus"
            app:tint="@color/hn_text_primary"
            android:contentDescription="@string/cd_fan_plus" />
    </LinearLayout>

    <!-- ================ AIRFLOW + FRESH/RECIRCULATE ================ -->
    <LinearLayout
        android:id="@+id/airSourceSection"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hn_airflow_row_height"
        android:layout_marginTop="@dimen/hn_section_gap"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Fresh air / recirculate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/hn_space_8">
            <LinearLayout
                android:id="@+id/btnFreshAir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_control_selected"
                android:padding="@dimen/hn_space_8">
                <ImageView android:layout_width="@dimen/hn_icon_medium"
                    android:layout_height="@dimen/hn_icon_medium"
                    android:src="@drawable/ic_fresh_air" app:tint="@color/hn_primary_cyan"
                    android:contentDescription="@string/label_fresh_air" />
                <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/hn_space_4"
                    android:text="@string/label_fresh_air" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnRecirculation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/hn_space_8"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_control_toggle"
                android:padding="@dimen/hn_space_8">
                <ImageView android:layout_width="@dimen/hn_icon_medium"
                    android:layout_height="@dimen/hn_icon_medium"
                    android:src="@drawable/ic_recirculate" app:tint="@color/hn_text_secondary"
                    android:contentDescription="@string/label_recirculate" />
                <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/hn_space_4"
                    android:text="@string/label_recirculate" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========================= DEFROST ========================= -->
    <LinearLayout
        android:id="@+id/defrostSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hn_section_gap"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout android:id="@+id/btnFrontDefrost" style="@style/HnDefrostPill">
            <ImageView android:layout_width="@dimen/hn_icon_medium" android:layout_height="@dimen/hn_icon_medium"
                android:src="@drawable/ic_defrost_front" app:tint="@color/hn_text_secondary"
                android:contentDescription="@string/label_front_defrost" />
            <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="@dimen/hn_space_8"
                android:text="@string/label_front_defrost" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnRearDefrost" style="@style/HnDefrostPill"
            android:layout_marginStart="@dimen/hn_space_8">
            <ImageView android:layout_width="@dimen/hn_icon_medium" android:layout_height="@dimen/hn_icon_medium"
                android:src="@drawable/ic_defrost_rear" app:tint="@color/hn_text_secondary"
                android:contentDescription="@string/label_rear_defrost" />
            <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="@dimen/hn_space_8"
                android:text="@string/label_rear_defrost" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnMaxDefrost" style="@style/HnDefrostPill"
            android:layout_marginStart="@dimen/hn_space_8">
            <ImageView android:layout_width="@dimen/hn_icon_medium" android:layout_height="@dimen/hn_icon_medium"
                android:src="@drawable/ic_max_defrost" app:tint="@color/hn_text_secondary"
                android:contentDescription="@string/label_max_defrost" />
            <TextView style="@style/HnText.Label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="@dimen/hn_space_8"
                android:text="@string/label_max_defrost" />
        </LinearLayout>
    </LinearLayout>




</LinearLayout>
