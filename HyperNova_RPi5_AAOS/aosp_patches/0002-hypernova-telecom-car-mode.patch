+    /**
+     * Seeds the car-mode InCallService from product configuration.
+     *
+     * Generic AOSP leaves the package resource empty, which preserves the
+     * existing behavior. Automotive products can provide a package and
+     * priority through a product resource overlay.
+     */
+    private void initializeConfiguredCarModeInCallService() {
+        String packageName = mContext.getString(
+                R.string.default_car_mode_incall_service_package);
+
+        if (TextUtils.isEmpty(packageName)) {
+            return;
+        }
+
+        int priority = mContext.getResources().getInteger(
+                R.integer.default_car_mode_incall_service_priority);
+
+        priority = Math.max(0, priority);
+
+        Log.i(this,
+                "initializeConfiguredCarModeInCallService: "
+                        + "packageName=%s, priority=%d",
+                packageName,
+                priority);
+
+        mCarModeTracker.handleEnterCarMode(priority, packageName);
+    }
