<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        HyperNova AAOS persistent car-mode InCallService.

        This reproduces at boot the validated runtime state:

            CarModeTracker:
              [100] com.hypernova.phone

        No ADB broadcast is required on the final SD-card image.
    -->

    <string
        name="default_car_mode_incall_service_package"
        translatable="false">com.hypernova.phone</string>

    <integer
        name="default_car_mode_incall_service_priority">100</integer>

</resources>
