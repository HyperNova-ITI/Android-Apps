<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="8.45%p"
    android:keyHeight="56dp"
    android:horizontalGap="0.35%p"
    android:verticalGap="5dp">

    <!-- Permanent number row: always visible for Wi-Fi passwords and PINs. -->
    <Row android:rowEdgeFlags="top">
        <Key android:keyLabel="1" android:keyEdgeFlags="left" />
        <Key android:keyLabel="2" />
        <Key android:keyLabel="3" />
        <Key android:keyLabel="4" />
        <Key android:keyLabel="5" />
        <Key android:keyLabel="6" />
        <Key android:keyLabel="7" />
        <Key android:keyLabel="8" />
        <Key android:keyLabel="9" />
        <Key android:keyLabel="0" />
        <Key
            android:codes="@integer/keycode_delete"
            android:keyIcon="@drawable/ic_backspace_tint"
            android:keyEdgeFlags="right"
            android:isRepeatable="true" />
    </Row>

    <Row>
        <Key android:keyLabel="q" android:keyEdgeFlags="left" />
        <Key android:keyLabel="w" />
        <Key
            android:keyLabel="e"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_e" />
        <Key android:keyLabel="r" />
        <Key android:keyLabel="t" />
        <Key
            android:keyLabel="y"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_y" />
        <Key
            android:keyLabel="u"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_u" />
        <Key
            android:keyLabel="i"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_i" />
        <Key
            android:keyLabel="o"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_o" />
        <Key android:keyLabel="p" />
        <Key
            android:codes="@integer/keycode_return"
            android:keyIcon="@drawable/ic_keyboard_return"
            android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key
            android:keyLabel="a"
            android:horizontalGap="4.4%p"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_a" />
        <Key
            android:keyLabel="s"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_s" />
        <Key android:keyLabel="d" />
        <Key android:keyLabel="f" />
        <Key android:keyLabel="g" />
        <Key android:keyLabel="h" />
        <Key android:keyLabel="j" />
        <Key android:keyLabel="k" />
        <Key
            android:keyLabel="l"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_l" />
        <Key
            android:keyLabel="'"
            android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:keyLabel="\@" android:keyEdgeFlags="left" />
        <Key
            android:keyLabel="z"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_z" />
        <Key android:keyLabel="x" />
        <Key
            android:keyLabel="c"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_c" />
        <Key android:keyLabel="v" />
        <Key android:keyLabel="b" />
        <Key
            android:keyLabel="n"
            android:popupKeyboard="@xml/keyboard_popup_template"
            android:popupCharacters="@string/alternates_for_n" />
        <Key android:keyLabel="m" />
        <Key android:keyLabel="!" />
        <Key android:keyLabel="\?" />
        <Key
            android:codes="@integer/keycode_shift"
            android:isSticky="true"
            android:isModifier="true"
            android:keyIcon="@drawable/ic_keyboard_shift"
            android:keyEdgeFlags="right" />
    </Row>

    <Row android:rowEdgeFlags="bottom">
        <Key
            android:codes="@integer/keycode_close_keyboard"
            android:keyIcon="@drawable/ic_close_keyboard"
            android:horizontalGap="6.8%p"
            android:keyEdgeFlags="left" />
        <Key android:keyLabel="_" />
        <Key android:keyLabel="-" />
        <Key
            android:codes="@integer/keycode_space"
            android:keyIcon="@drawable/ic_keyboard_spacebar"
            android:keyWidth="31%p" />
        <Key android:keyLabel="," />
        <Key android:keyLabel="." />
        <Key
            android:codes="@integer/keycode_mode_change"
            android:keyLabel="#+="
            android:keyWidth="11%p"
            android:keyEdgeFlags="right" />
    </Row>

</Keyboard>
