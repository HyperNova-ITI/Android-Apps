<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="@string/psk_wifi_list"
    android:title="@string/hypernova_wifi">

    <!-- ===================================================== -->
    <!-- WI-FI STATE                                           -->
    <!-- ===================================================== -->

    <PreferenceCategory>

        <com.android.car.settings.common.ColoredSwitchPreference
            android:icon="@drawable/hypernova_ic_wifi"
            android:key="@string/pk_wifi_state_switch"
            android:layout="@layout/car_ui_preference_primary_switch_internal"
            android:title="@string/hypernova_wifi"
            style="@style/ColoredSwitchPreferenceStyle"
            settings:controller="com.android.car.settings.hypernova.HyperNovaWifiStatePreferenceController"
            settings:occupant_front_passenger="read"
            settings:occupant_rear_passenger="read"
            settings:searchable="false" />

    </PreferenceCategory>


    <!-- ===================================================== -->
    <!-- CONNECTED NETWORK                                     -->
    <!-- ===================================================== -->

    <PreferenceCategory
        android:key="@string/pk_hypernova_connected_wifi"
        android:title="@string/hypernova_section_connected_network"
        settings:controller="com.android.car.settings.hypernova.HyperNovaConnectedWifiPreferenceController" />


    <!-- ===================================================== -->
    <!-- AVAILABLE NETWORKS                                    -->
    <!-- ===================================================== -->

    <PreferenceCategory
        android:key="@string/pk_wifi_list"
        android:title="@string/hypernova_section_networks"
        settings:controller="com.android.car.settings.hypernova.HyperNovaAvailableWifiPreferenceController"
        settings:occupant_front_passenger="read"
        settings:occupant_rear_passenger="read" />


    <!-- ===================================================== -->
    <!-- ADD NETWORK                                           -->
    <!-- ===================================================== -->

    <PreferenceCategory>

        <com.android.car.ui.preference.CarUiPreference
            android:fragment="com.android.car.settings.wifi.AddWifiFragment"
            android:icon="@drawable/hypernova_ic_plus"
            android:key="@string/pk_add_wifi"
            android:layout="@layout/hypernova_preference"
            android:title="@string/wifi_setup_add_network"
            settings:controller="com.android.car.settings.wifi.AddWifiPreferenceController"
            settings:occupant_front_passenger="read"
            settings:occupant_rear_passenger="read"
            settings:showChevron="true" />

    </PreferenceCategory>

</PreferenceScreen>
