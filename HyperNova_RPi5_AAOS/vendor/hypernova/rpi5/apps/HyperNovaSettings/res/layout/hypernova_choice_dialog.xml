<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hypernova_dialog_background"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/hypernova_choice_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/hypernova_text_primary"
        android:textSize="21sp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/hypernova_choice_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/hypernova_text_secondary"
        android:textSize="13sp" />

    <!-- Cyan accent -->
    <View
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:background="@color/hypernova_cyan" />

    <!-- Option 1 -->
    <include
        android:id="@+id/hypernova_choice_option_1"
        layout="@layout/hypernova_choice_option_row"
        android:layout_width="match_parent"
        android:layout_height="78dp" />

    <!-- Option 2 -->
    <include
        android:id="@+id/hypernova_choice_option_2"
        layout="@layout/hypernova_choice_option_row"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginTop="8dp" />

    <!-- Option 3 -->
    <include
        android:id="@+id/hypernova_choice_option_3"
        layout="@layout/hypernova_choice_option_row"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginTop="8dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        android:background="@color/hypernova_divider" />

    <!-- Cancel -->
    <TextView
        android:id="@+id/hypernova_choice_cancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/hypernova_dialog_cancel_background"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        android:textColor="@color/hypernova_text_primary"
        android:textSize="15sp" />

</LinearLayout>
