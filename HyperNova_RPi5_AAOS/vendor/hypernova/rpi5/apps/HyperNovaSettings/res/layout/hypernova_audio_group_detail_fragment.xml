<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hypernova_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/hypernova_page_margin"
    android:paddingEnd="@dimen/hypernova_page_margin"
    android:paddingBottom="@dimen/hypernova_space_32">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Volume section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/HyperNovaText.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hypernova_audio_group_volume" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@color/hypernova_divider" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/hypernova_audio_group_detail_card"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:background="@drawable/hypernova_card_background"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hypernova_audio_group_detail_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@drawable/hypernova_ic_volume"
                    android:tint="@color/hypernova_cyan" />

                <TextView
                    android:id="@+id/hypernova_audio_group_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/hypernova_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/hypernova_audio_group_detail_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/hypernova_touch_target"
                    android:layout_height="@dimen/hypernova_touch_target">

                    <ImageButton
                        android:id="@+id/hypernova_audio_group_detail_decrease"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:background="@drawable/hypernova_round_control_background"
                        android:contentDescription="@string/hypernova_decrease"
                        android:padding="10dp"
                        android:src="@drawable/hypernova_ic_minus"
                        android:tint="@color/hypernova_text_primary" />

                </FrameLayout>


                <SeekBar
                    android:id="@+id/hypernova_audio_group_detail_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/hypernova_touch_target"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/hypernova_seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/hypernova_seekbar_thumb" />


                <FrameLayout
                    android:layout_width="@dimen/hypernova_touch_target"
                    android:layout_height="@dimen/hypernova_touch_target">

                    <ImageButton
                        android:id="@+id/hypernova_audio_group_detail_increase"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:background="@drawable/hypernova_round_control_background"
                        android:contentDescription="@string/hypernova_increase"
                        android:padding="10dp"
                        android:src="@drawable/hypernova_ic_plus"
                        android:tint="@color/hypernova_text_primary" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>


        <Space
            android:layout_width="1dp"
            android:layout_height="32dp" />

    </LinearLayout>

</ScrollView>
