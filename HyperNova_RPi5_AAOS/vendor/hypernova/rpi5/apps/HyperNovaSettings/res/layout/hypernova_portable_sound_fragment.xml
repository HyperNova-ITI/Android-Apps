<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hypernova_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="44dp">

        <TextView
            style="@style/HyperNovaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hypernova_audio_center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/hypernova_audio_panel_background"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/hypernova_icon_halo_background">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/hypernova_sound"
                        android:src="@drawable/hypernova_ic_volume"
                        android:tint="@color/hypernova_cyan" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/hypernova_portable_audio_backend_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/hypernova_text_primary"
                        android:textSize="19sp" />
                    <TextView
                        android:id="@+id/hypernova_portable_audio_backend_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="2"
                        android:textColor="@color/hypernova_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="174dp"
                android:layout_height="174dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@drawable/hypernova_audio_orb_background">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/hypernova_portable_audio_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/hypernova_cyan_bright"
                        android:textSize="44sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/hypernova_audio_level"
                        android:textAllCaps="true"
                        android:textColor="@color/hypernova_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <SeekBar
                android:id="@+id/hypernova_portable_audio_seekbar"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="18dp"
                android:progressBackgroundTint="@color/hypernova_divider"
                android:progressTint="@color/hypernova_cyan"
                android:splitTrack="false"
                android:thumbTint="@color/hypernova_cyan_bright" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/hypernova_portable_audio_decrease"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/hypernova_audio_action_background"
                    android:contentDescription="@string/hypernova_audio_decrease"
                    android:padding="20dp"
                    android:src="@drawable/hypernova_ic_minus"
                    android:tint="@color/hypernova_text_primary" />
                <Space android:layout_width="12dp" android:layout_height="1dp" />
                <ImageButton
                    android:id="@+id/hypernova_portable_audio_increase"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/hypernova_audio_action_background"
                    android:contentDescription="@string/hypernova_audio_increase"
                    android:padding="20dp"
                    android:src="@drawable/hypernova_ic_plus"
                    android:tint="@color/hypernova_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/hypernova_status_premium_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/hypernova_audio_test"
                        android:textColor="@color/hypernova_text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/hypernova_audio_test_summary"
                        android:textColor="@color/hypernova_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/hypernova_portable_audio_test"
                    android:layout_width="132dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/hypernova_audio_primary_button_background"
                    android:text="@string/hypernova_audio_test"
                    android:textAllCaps="false"
                    android:textColor="@color/hypernova_text_on_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hypernova_portable_audio_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/hypernova_cyan"
                android:textSize="13sp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
