<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hypernova_dialog_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/hypernova_add_network_title"
            android:textColor="@color/hypernova_text_primary"
            android:textSize="21sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hypernova_add_network_subtitle"
            android:textColor="@color/hypernova_text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:background="@color/hypernova_cyan" />

        <!-- Network name -->
        <TextView
            style="@style/HyperNovaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hypernova_network_name" />

        <EditText
            android:id="@+id/hypernova_add_wifi_ssid"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/hypernova_text_input_background"
            android:fontFamily="sans-serif"
            android:hint="@string/hypernova_network_name_hint"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/hypernova_text_primary"
            android:textColorHint="@color/hypernova_text_disabled"
            android:textSize="15sp" />

        <!-- Security -->
        <TextView
            style="@style/HyperNovaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/hypernova_security" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hypernova_security_open"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/hypernova_dialog_option_selected_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/hypernova_security_open"
                android:textColor="@color/hypernova_cyan"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hypernova_security_wpa2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/hypernova_dialog_option_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/hypernova_security_wpa2"
                android:textColor="@color/hypernova_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hypernova_security_wpa3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/hypernova_dialog_option_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/hypernova_security_wpa3"
                android:textColor="@color/hypernova_text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Password -->
        <LinearLayout
            android:id="@+id/hypernova_add_wifi_password_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/HyperNovaText.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hypernova_wifi_password" />

            <EditText
                android:id="@+id/hypernova_add_wifi_password"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/hypernova_text_input_background"
                android:fontFamily="sans-serif"
                android:hint="@string/hypernova_wifi_password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/hypernova_text_primary"
                android:textColorHint="@color/hypernova_text_disabled"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@color/hypernova_divider" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hypernova_add_wifi_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/hypernova_dialog_cancel_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@android:string/cancel"
                android:textColor="@color/hypernova_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hypernova_add_wifi_connect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/hypernova_primary_button_background"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/hypernova_connect"
                android:textColor="@color/hypernova_text_on_accent"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
