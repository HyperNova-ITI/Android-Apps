<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/hypernova_touch_target"
    android:minWidth="@dimen/hypernova_touch_target">

    <com.android.car.ui.uxr.DrawableStateSwitch
        android:id="@android:id/switch_widget"
        android:layout_width="@dimen/hypernova_switch_visual_width"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:background="@null"
        android:clickable="false"
        android:focusable="false"
        android:showText="false"
        android:splitTrack="false"
        android:switchMinWidth="@dimen/hypernova_switch_visual_width"
        android:thumb="@drawable/hypernova_switch_thumb_drawable"
        android:track="@drawable/hypernova_switch_track_drawable" />
</FrameLayout>
