<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hypernova_row_min_height"
    android:background="@drawable/hypernova_card_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/hypernova_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="15dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/hypernova_row_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:tint="@color/hypernova_cyan" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hypernova_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/hypernova_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hypernova_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/hypernova_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/hypernova_chevron_size"
        android:layout_height="@dimen/hypernova_chevron_size"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/hypernova_ic_chevron"
        android:tint="@color/hypernova_text_primary" />

</LinearLayout>
