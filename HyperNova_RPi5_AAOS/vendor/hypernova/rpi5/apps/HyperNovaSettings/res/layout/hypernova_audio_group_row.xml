<?xml version="1.0" encoding="utf-8"?>
<!-- Compact navigation row used for a real AAOS audio volume group. -->
<com.android.car.ui.uxr.DrawableStateRelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hypernova_compact_row_height"
    android:layout_marginBottom="@dimen/hypernova_space_8"
    android:background="@drawable/hypernova_card_background"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/hypernova_space_16"
    android:paddingEnd="@dimen/hypernova_space_8"
    android:tag="carUiPreference">

    <com.android.car.ui.uxr.DrawableStateImageView
        android:id="@android:id/icon"
        android:layout_width="@dimen/hypernova_icon_size"
        android:layout_height="@dimen/hypernova_icon_size"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/hypernova_space_14"
        android:scaleType="fitCenter"
        android:tint="@color/hypernova_cyan" />

    <FrameLayout
        android:id="@android:id/widget_frame"
        android:layout_width="@dimen/hypernova_touch_target"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:gravity="center" />

    <com.android.car.ui.uxr.DrawableStateTextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/hypernova_space_12"
        android:layout_marginEnd="@dimen/hypernova_space_4"
        android:layout_toStartOf="@android:id/widget_frame"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/HyperNovaText.Value" />

    <com.android.car.ui.uxr.DrawableStateTextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@android:id/icon"
        android:layout_toStartOf="@android:id/summary"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/HyperNovaText.RowTitle" />
</com.android.car.ui.uxr.DrawableStateRelativeLayout>
