<com.android.car.ui.uxr.DrawableStateRelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/hypernova_space_8"
    android:background="@drawable/hypernova_card_background"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/hypernova_row_min_height"
    android:paddingStart="@dimen/hypernova_space_16"
    android:paddingEnd="@dimen/hypernova_space_16"
    android:tag="carUiPreference">

    <com.android.car.ui.uxr.DrawableStateImageView
        android:id="@android:id/icon"
        android:layout_width="@dimen/hypernova_icon_size"
        android:layout_height="@dimen/hypernova_icon_size"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/hypernova_space_14"
        android:scaleType="fitCenter"
        android:tint="@color/hypernova_cyan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/hypernova_space_10"
        android:layout_toEndOf="@android:id/icon"
        android:layout_toStartOf="@android:id/widget_frame"
        android:orientation="vertical">

        <com.android.car.ui.uxr.DrawableStateTextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.CarUi.PreferenceTitle" />

        <com.android.car.ui.uxr.DrawableStateTextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hypernova_space_2"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.CarUi.PreferenceSummary" />
    </LinearLayout>

    <FrameLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:minWidth="@dimen/hypernova_touch_target"
        android:gravity="center" />
</com.android.car.ui.uxr.DrawableStateRelativeLayout>
