<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hypernova_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="@dimen/hypernova_page_margin"
    android:paddingEnd="@dimen/hypernova_page_margin"
    android:paddingBottom="@dimen/hypernova_space_32">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============================================================ -->
        <!-- BRIGHTNESS                                                   -->
        <!-- ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/HyperNovaText.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hypernova_section_brightness" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@color/hypernova_divider" />

        </LinearLayout>


        <!-- ============================================================ -->
        <!-- BRIGHTNESS LEVEL CARD                                        -->
        <!-- ============================================================ -->

        <LinearLayout
            android:id="@+id/hypernova_brightness_card"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:background="@drawable/hypernova_card_background"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Title / current value -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@drawable/hypernova_ic_display"
                    android:tint="@color/hypernova_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/hypernova_brightness_level"
                        android:textColor="@color/hypernova_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/hypernova_brightness_sub_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/hypernova_cyan"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/hypernova_brightness_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- MINUS touch target -->
                <FrameLayout
                    android:layout_width="@dimen/hypernova_touch_target"
                    android:layout_height="@dimen/hypernova_touch_target">

                    <ImageButton
                        android:id="@+id/hypernova_brightness_decrease"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:background="@drawable/hypernova_round_control_background"
                        android:contentDescription="@string/hypernova_decrease"
                        android:padding="10dp"
                        android:src="@drawable/hypernova_ic_minus"
                        android:tint="@color/hypernova_text_primary" />

                </FrameLayout>


                <SeekBar
                    android:id="@+id/hypernova_brightness_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/hypernova_touch_target"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:progressDrawable="@drawable/hypernova_seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/hypernova_seekbar_thumb" />


                <!-- PLUS touch target -->
                <FrameLayout
                    android:layout_width="@dimen/hypernova_touch_target"
                    android:layout_height="@dimen/hypernova_touch_target">

                    <ImageButton
                        android:id="@+id/hypernova_brightness_increase"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:background="@drawable/hypernova_round_control_background"
                        android:contentDescription="@string/hypernova_increase"
                        android:padding="10dp"
                        android:src="@drawable/hypernova_ic_plus"
                        android:tint="@color/hypernova_text_primary" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- ============================================================ -->
        <!-- AUTOMATIC BRIGHTNESS                                         -->
        <!-- ============================================================ -->

        <LinearLayout
            android:id="@+id/hypernova_auto_brightness_card"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/hypernova_card_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/hypernova_automatic_brightness"
                    android:textColor="@color/hypernova_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/hypernova_auto_brightness_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>


            <Switch
                android:id="@+id/hypernova_auto_brightness_switch"
                android:layout_width="52dp"
                android:layout_height="@dimen/hypernova_touch_target"
                android:background="@null"
                android:showText="false"
                android:splitTrack="false"
                android:switchMinWidth="@dimen/hypernova_switch_visual_width"
                android:thumb="@drawable/hypernova_switch_thumb_drawable"
                android:track="@drawable/hypernova_switch_track_drawable" />

        </LinearLayout>


        <!-- ============================================================ -->
        <!-- THEME                                                        -->
        <!-- ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/HyperNovaText.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hypernova_section_theme" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@color/hypernova_divider" />

        </LinearLayout>


        <!-- One rounded group like the reference -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hypernova_card_background"
            android:clipToOutline="true"
            android:orientation="vertical">


            <!-- DAY / NIGHT MODE -->
            <LinearLayout
                android:id="@+id/hypernova_day_night_row"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@drawable/hypernova_ic_time"
                    android:tint="@color/hypernova_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/hypernova_theme_mode"
                        android:textColor="@color/hypernova_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/hypernova_day_night_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/hypernova_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/hypernova_ic_chevron"
                    android:tint="@color/hypernova_text_primary" />

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="54dp"
                android:background="@color/hypernova_divider" />


            <!-- THEME STYLE -->
            <LinearLayout
                android:id="@+id/hypernova_theme_style_row"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:scaleType="centerInside"
                    android:src="@drawable/hypernova_ic_settings"
                    android:tint="@color/hypernova_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/hypernova_theme_style"
                        android:textColor="@color/hypernova_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/hypernova_theme_style_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/hypernova_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/hypernova_ic_chevron"
                    android:tint="@color/hypernova_text_primary" />

            </LinearLayout>

        </LinearLayout>


        <Space
            android:layout_width="1dp"
            android:layout_height="32dp" />

    </LinearLayout>

</ScrollView>
