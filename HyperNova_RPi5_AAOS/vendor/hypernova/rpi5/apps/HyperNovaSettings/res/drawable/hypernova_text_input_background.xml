<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">

        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_card" />

            <stroke
                android:width="2dp"
                android:color="@color/hypernova_cyan" />

            <corners android:radius="14dp" />

            <padding
                android:left="14dp"
                android:top="4dp"
                android:right="14dp"
                android:bottom="4dp" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_card" />

            <stroke
                android:width="1dp"
                android:color="@color/hypernova_border_soft" />

            <corners android:radius="14dp" />

            <padding
                android:left="14dp"
                android:top="4dp"
                android:right="14dp"
                android:bottom="4dp" />

        </shape>

    </item>

</selector>
