<?xml version="1.0" encoding="utf-8"?>
<!-- The visible thumb remains 16dp; the parent SeekBar supplies the 48dp touch target. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <size
                android:width="@dimen/hypernova_slider_thumb_size"
                android:height="@dimen/hypernova_slider_thumb_size" />
            <solid android:color="@color/hypernova_text_disabled" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size
                android:width="@dimen/hypernova_slider_thumb_size"
                android:height="@dimen/hypernova_slider_thumb_size" />
            <solid android:color="@color/hypernova_cyan_bright" />
            <stroke android:width="1dp" android:color="@color/hypernova_text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size
                android:width="@dimen/hypernova_slider_thumb_size"
                android:height="@dimen/hypernova_slider_thumb_size" />
            <solid android:color="@color/hypernova_cyan" />
            <stroke android:width="1dp" android:color="@color/hypernova_cyan_bright" />
        </shape>
    </item>
</selector>
