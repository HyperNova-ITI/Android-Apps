<?xml version="1.0" encoding="utf-8"?>
<!-- A 4dp visual track inside the 48dp accessible SeekBar touch container. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/background"
        android:height="@dimen/hypernova_slider_track_height"
        android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_border_soft" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/secondaryProgress"
        android:height="@dimen/hypernova_slider_track_height"
        android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/hypernova_cyan_dark" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
    <item
        android:id="@android:id/progress"
        android:height="@dimen/hypernova_slider_track_height"
        android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/hypernova_cyan" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
