<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_runtime_surface" />
            <stroke
                android:width="2dp"
                android:color="@color/hypernova_runtime_cyan" />
            <corners android:radius="14dp" />
            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_runtime_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/hypernova_runtime_border" />
            <corners android:radius="14dp" />
            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp" />
        </shape>
    </item>

</selector>
