<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">

            <solid android:color="@color/hypernova_transparent" />

            <stroke
                android:width="2dp"
                android:color="@color/hypernova_cyan" />

        </shape>
    </item>

    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">

        <shape android:shape="oval">

            <solid android:color="@color/hypernova_cyan_bright" />

        </shape>

    </item>

</layer-list>
