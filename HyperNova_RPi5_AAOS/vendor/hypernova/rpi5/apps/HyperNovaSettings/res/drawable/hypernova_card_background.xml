<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_card" />

            <stroke
                android:width="@dimen/hypernova_card_stroke"
                android:color="@color/hypernova_divider" />

            <corners android:radius="@dimen/hypernova_card_radius" />

        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_selected" />

            <stroke
                android:width="@dimen/hypernova_card_stroke"
                android:color="@color/hypernova_cyan" />

            <corners android:radius="@dimen/hypernova_card_radius" />

        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_selected" />

            <stroke
                android:width="@dimen/hypernova_card_stroke"
                android:color="@color/hypernova_cyan_bright" />

            <corners android:radius="@dimen/hypernova_card_radius" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_card" />

            <stroke
                android:width="@dimen/hypernova_card_stroke"
                android:color="@color/hypernova_border_soft" />

            <corners android:radius="@dimen/hypernova_card_radius" />

        </shape>
    </item>

</selector>
