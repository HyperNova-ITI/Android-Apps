<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_runtime_selected" />
            <stroke
                android:width="2dp"
                android:color="@color/hypernova_runtime_cyan" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_runtime_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/hypernova_runtime_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</selector>
