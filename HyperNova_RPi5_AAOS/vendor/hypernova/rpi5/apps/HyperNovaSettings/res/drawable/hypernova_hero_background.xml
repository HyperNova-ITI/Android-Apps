<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="0" android:startColor="#162D44" android:endColor="#0A1B2D" />
            <stroke android:width="1dp" android:color="@color/hypernova_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="0" android:startColor="@color/hypernova_card_elevated" android:endColor="@color/hypernova_card" />
            <stroke android:width="1dp" android:color="@color/hypernova_border_soft" />
        </shape>
    </item>
</selector>
