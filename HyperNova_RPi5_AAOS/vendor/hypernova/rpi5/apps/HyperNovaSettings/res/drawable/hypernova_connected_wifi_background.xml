<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_selected" />

            <stroke
                android:width="1dp"
                android:color="@color/hypernova_cyan_bright" />

            <corners android:radius="@dimen/hypernova_card_radius" />

        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_selected" />

            <stroke
                android:width="1dp"
                android:color="@color/hypernova_cyan_bright" />

            <corners android:radius="@dimen/hypernova_card_radius" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/hypernova_card_elevated" />

            <stroke
                android:width="1dp"
                android:color="@color/hypernova_cyan_dark" />

            <corners android:radius="@dimen/hypernova_card_radius" />

        </shape>
    </item>

</selector>
