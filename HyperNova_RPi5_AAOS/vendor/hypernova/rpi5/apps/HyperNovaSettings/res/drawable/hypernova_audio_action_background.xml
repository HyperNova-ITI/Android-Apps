<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/hypernova_selected" />
            <stroke android:width="1dp" android:color="@color/hypernova_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/hypernova_background_secondary" />
            <stroke android:width="1dp" android:color="@color/hypernova_border_soft" />
        </shape>
    </item>
</selector>
