<resources>
    <style name="Base.Theme.HyperNova" parent="@style/CarSettingTheme">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/hypernova_background</item>
        <item name="android:colorBackground">@color/hypernova_background</item>
        <item name="android:colorAccent">@color/hypernova_cyan</item>
        <item name="android:colorControlNormal">@color/hypernova_text_secondary</item>
        <item name="android:colorControlActivated">@color/hypernova_cyan</item>
        <item name="android:textColorPrimary">@color/hypernova_text_primary</item>
        <item name="android:textColorSecondary">@color/hypernova_text_secondary</item>
        <item name="android:navigationBarColor">@color/hypernova_background</item>
        <item name="android:statusBarColor">@color/hypernova_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@style/HyperNovaActivityAnimation</item>
        <item name="android:alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="android:dialogTheme">@style/ActionDialogTheme</item>
        <item name="preferenceTheme">@style/CarSettingsPreferenceTheme</item>
        <item name="dividerColor">@color/hypernova_divider</item>
        <item name="profileSwitcherCurrentProfileColor">@color/hypernova_cyan</item>
        <item name="suggestionsPrimaryColor">@color/hypernova_card_elevated</item>
        <item name="suggestionsSecondaryColor">@color/hypernova_text_primary</item>
    </style>

    <style name="Theme.HyperNova" parent="@style/Base.Theme.HyperNova">
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- AOSP Wi-Fi credentials, Bluetooth pairing, and permission confirmations continue to own
         their behavior. These app-priority theme resources keep those deep flows in the same
         HyperNova palette instead of falling back to stock DeviceDefault surfaces. -->
    <style name="ActionDialogTheme" parent="@style/Theme.HyperNova">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@style/HyperNovaDialogAnimation</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <style name="AlertDialogTheme" parent="@style/Theme.HyperNova">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@style/HyperNovaDialogAnimation</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <style name="CarSettingsPreferenceTheme" parent="@style/CarUiPreferenceTheme">
        <item name="preferenceFragmentCompatStyle">@style/CarSettingsPreferenceFragment</item>
        <item name="preferenceFragmentStyle">@style/CarSettingsPreferenceFragment</item>
        <item name="preferenceFragmentListStyle">@style/HyperNovaPreferenceFragmentList</item>
        <item name="preferenceStyle">@style/HyperNovaPreferenceStyle</item>
        <item name="carUiPreferenceStyle">@style/HyperNovaPreferenceStyle</item>
        <item name="preferenceCategoryStyle">@style/HyperNovaPreferenceCategoryStyle</item>
        <item name="switchPreferenceStyle">@style/HyperNovaSwitchPreferenceStyle</item>
        <item name="seekBarPreferenceStyle">@style/HyperNovaSeekBarPreferenceStyle</item>
        <item name="dialogPreferenceStyle">@style/HyperNovaPreferenceStyle</item>
        <item name="dropdownPreferenceStyle">@style/HyperNovaPreferenceStyle</item>
        <item name="editTextPreferenceStyle">@style/HyperNovaPreferenceStyle</item>
    </style>

    <style name="HyperNovaPreferenceStyle" parent="@style/Preference.CarUi">
        <item name="android:layout">@layout/hypernova_preference</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HyperNovaSwitchPreferenceStyle" parent="@style/Preference.CarUi.SwitchPreference">
        <item name="android:layout">@layout/hypernova_preference</item>
        <item name="android:widgetLayout">@layout/hypernova_switch_widget</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HyperNovaSeekBarPreferenceStyle"
        parent="@style/Preference.CarUi.SeekBarPreference">
        <item name="android:layout">@layout/hypernova_seekbar_preference</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HyperNovaPreferenceCategoryStyle" parent="@style/Preference.CarUi.Category">
        <item name="android:layout">@layout/hypernova_preference_category</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HyperNovaPreferenceFragmentList" parent="@style/PreferenceFragmentList.CarUi">
        <item name="android:background">@color/hypernova_background</item>
        <item name="android:paddingStart">@dimen/hypernova_page_margin</item>
        <item name="android:paddingEnd">@dimen/hypernova_page_margin</item>
        <item name="android:paddingBottom">@dimen/hypernova_space_32</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="HyperNovaText.ScreenTitle"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/hypernova_text_primary</item>
        <item name="android:textSize">@dimen/hypernova_toolbar_title_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="HyperNovaText.Section"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/hypernova_text_secondary</item>
        <item name="android:textSize">@dimen/hypernova_section_text_size</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
    </style>

    <style name="HyperNovaText.RowTitle"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/hypernova_text_primary</item>
        <item name="android:textSize">@dimen/hypernova_title_text_size</item>
    </style>

    <style name="HyperNovaText.Summary"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/hypernova_text_secondary</item>
        <item name="android:textSize">@dimen/hypernova_body_text_size</item>
    </style>

    <style name="HyperNovaText.Value"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/hypernova_text_secondary</item>
        <item name="android:textSize">@dimen/hypernova_value_text_size</item>
    </style>

    <!-- CarUi installs the toolbar around BaseCarSettingsActivity content. These app-local style
         replacements produce the shared compact HyperNova header without losing rotary support. -->
    <style name="Widget.CarUi.Toolbar.Container">
        <item name="android:background">@color/hypernova_background</item>
    </style>

    <style name="Widget.CarUi.Toolbar.Title">
        <item name="android:textColor">@color/hypernova_text_primary</item>
        <item name="android:textSize">@dimen/hypernova_toolbar_title_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <style name="Widget.CarUi.Toolbar.NavIcon">
        <item name="android:tint">@color/hypernova_text_primary</item>
        <item name="android:background">@drawable/hypernova_icon_button_background</item>
    </style>

    <style name="Widget.CarUi.Toolbar.SeparatorView">
        <item name="android:height">1dp</item>
        <item name="android:background">@color/hypernova_divider</item>
    </style>

    <style name="Widget.CarUi.Toolbar.BottomView">
        <item name="android:height">1dp</item>
        <item name="android:background">@color/hypernova_divider</item>
    </style>

    <style name="Widget.CarUi.SeekbarPreference.Seekbar">
        <item name="android:background">@null</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:minHeight">@dimen/hypernova_touch_target</item>
        <item name="android:maxHeight">@dimen/hypernova_touch_target</item>
        <item name="android:progressDrawable">@drawable/hypernova_seekbar_progress</item>
        <item name="android:thumb">@drawable/hypernova_seekbar_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">@dimen/hypernova_space_4</item>
        <item name="android:paddingEnd">@dimen/hypernova_space_4</item>
    </style>

    <style name="TextAppearance.CarUi.PreferenceTitle"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textColor">@color/hypernova_text_primary</item>
        <item name="android:textSize">@dimen/hypernova_title_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.CarUi.PreferenceSummary"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textColor">@color/hypernova_text_secondary</item>
        <item name="android:textSize">@dimen/hypernova_body_text_size</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.CarUi.PreferenceCategoryTitle"
        parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textColor">@color/hypernova_text_secondary</item>
        <item name="android:textSize">@dimen/hypernova_section_text_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
    </style>

    <!-- Premium cockpit motion. Short enough for automotive interaction, visible enough to
         make Settings / dialog transitions feel intentional. -->
    <style name="HyperNovaActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/hypernova_activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/hypernova_activity_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/hypernova_activity_enter_reverse</item>
        <item name="android:activityCloseExitAnimation">@anim/hypernova_activity_exit_reverse</item>
    </style>

    <style name="HyperNovaDialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/hypernova_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/hypernova_dialog_exit</item>
    </style>

</resources>
