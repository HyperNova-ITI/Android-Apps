package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "HyperNovaSettings",

    platform_apis: true,

    srcs: [
        "src/**/*.java",
    ],

    resource_dirs: [
        "res",
    ],

    manifest: "AndroidManifest.xml",

    static_libs: [
        "CarSettings-core",
        "HyperNovaConnectivityContracts",
    ],

    libs: [
        "android.car",
    ],

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    optimize: {
        proguard_flags_files: [":CarSettings_proguard_flags"],
    },

    dex_preopt: {
        enabled: false,
    },

    required: [
        "allowed_privapp_com.hypernova.settings",
    ],

    dxflags: [
        "--multi-dex",
    ],

    aaptflags: [
        "--extra-packages",
        "com.android.car.settings",
    ],
}

prebuilt_etc {
    name: "allowed_privapp_com.hypernova.settings",

    system_ext_specific: true,

    sub_dir: "permissions",

    src: "privapp-permissions-com.hypernova.settings.xml",

    filename_from_src: true,
}
