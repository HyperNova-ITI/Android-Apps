<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_media_screen"
    android:orientation="vertical"
    android:paddingStart="@dimen/hn_screen_margin"
    android:paddingTop="@dimen/hn_space_8"
    android:paddingEnd="@dimen/hn_screen_margin"
    android:paddingBottom="@dimen/hn_space_12">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hn_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="@dimen/hn_touch_min"
            android:layout_height="@dimen/hn_touch_min"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            android:tint="@color/hypernova_icon_primary" />

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/hn_space_4"
            android:layout_marginEnd="@dimen/hn_space_12"
            android:background="@color/hypernova_divider" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_music" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hn_space_8"
            android:fontFamily="sans-medium"
            android:letterSpacing="0.04"
            android:text="@string/media_title"
            android:textColor="@color/hypernova_text_primary"
            android:textSize="@dimen/hn_text_title" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/header_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_cyan_dot"
            android:contentDescription="@string/content_description_status" />

        <TextView
            android:id="@+id/header_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/hn_space_8"
            android:ellipsize="end"
            android:fontFamily="sans-medium"
            android:maxLines="1"
            android:text="@string/select_source"
            android:textColor="@color/hypernova_text_secondary"
            android:textSize="@dimen/hn_text_header_status" />

        <TextClock
            android:id="@+id/header_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-medium"
            android:textColor="@color/hypernova_text_primary"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/source_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hn_source_height"
        android:layout_marginTop="@dimen/hn_space_8"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/card_radio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_source_card"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/hn_touch_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/hn_space_12"
            android:paddingEnd="@dimen/hn_space_8">

            <ImageView
                android:id="@+id/icon_radio"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:clickable="false"
                android:contentDescription="@null"
                android:focusable="false"
                android:src="@drawable/ic_radio"
                android:tint="@color/hypernova_icon_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hn_space_8"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:fontFamily="sans-medium"
                    android:maxLines="1"
                    android:text="@string/radio"
                    android:textColor="@color/hypernova_text_primary"
                    android:textSize="@dimen/hn_text_source_title" />

                <TextView
                    android:id="@+id/subtitle_radio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hn_space_4"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/fm_am"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="@dimen/hn_text_source_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_bluetooth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/hn_space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_source_card"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/hn_touch_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/hn_space_12"
            android:paddingEnd="@dimen/hn_space_8">

            <ImageView
                android:id="@+id/icon_bluetooth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="false"
                android:contentDescription="@null"
                android:focusable="false"
                android:src="@drawable/ic_bluetooth"
                android:tint="@color/hypernova_icon_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hn_space_8"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_bluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-medium"
                    android:maxLines="1"
                    android:text="@string/bluetooth"
                    android:textColor="@color/hypernova_text_primary"
                    android:textSize="@dimen/hn_text_source_title" />

                <TextView
                    android:id="@+id/subtitle_bluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hn_space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/bluetooth_no_device"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="@dimen/hn_text_source_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_usb"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/hn_space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_source_card"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/hn_touch_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/hn_space_12"
            android:paddingEnd="@dimen/hn_space_8">

            <ImageView
                android:id="@+id/icon_usb"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="false"
                android:contentDescription="@null"
                android:focusable="false"
                android:src="@drawable/ic_usb"
                android:tint="@color/hypernova_icon_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hn_space_8"
                android:layout_weight="1"
                android:clickable="false"
                android:focusable="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_usb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-medium"
                    android:maxLines="1"
                    android:text="@string/usb"
                    android:textColor="@color/hypernova_text_primary"
                    android:textSize="@dimen/hn_text_source_title" />

                <TextView
                    android:id="@+id/subtitle_usb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hn_space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/usb_not_connected"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="@dimen/hn_text_source_subtitle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/hn_space_16"
        android:background="@color/hypernova_divider" />

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/hn_space_8"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/home_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_artwork_placeholder">

            <ImageView
                android:id="@+id/hero_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/media_immersive_hero_hd" />

            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_hero_fade" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="@dimen/hn_space_24"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_equalizer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hn_space_8"
                    android:fontFamily="sans-medium"
                    android:letterSpacing="0.18"
                    android:text="@string/immersive_audio"
                    android:textColor="@color/hypernova_on_image"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hn_space_4"
                    android:text="@string/select_source_begin"
                    android:textColor="@color/hypernova_on_image_secondary"
                    android:textSize="@dimen/hn_text_body" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/state_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_content_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/hn_space_32"
            android:visibility="gone">

            <ImageView
                android:id="@+id/state_icon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info"
                android:tint="@color/hypernova_cyan" />

            <TextView
                android:id="@+id/state_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hn_space_20"
                android:fontFamily="sans-medium"
                android:letterSpacing="0.14"
                android:textColor="@color/hypernova_cyan"
                android:textSize="@dimen/hn_text_secondary" />

            <TextView
                android:id="@+id/state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hn_space_12"
                android:fontFamily="sans-medium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/hypernova_text_primary"
                android:textSize="@dimen/hn_text_media_title" />

            <TextView
                android:id="@+id/state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hn_space_8"
                android:gravity="center"
                android:maxLines="3"
                android:textColor="@color/hypernova_text_secondary"
                android:textSize="@dimen/hn_text_body" />

            <Button
                android:id="@+id/state_action"
                android:layout_width="220dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/hn_space_24"
                android:background="@drawable/bg_action_button"
                android:fontFamily="sans-medium"
                android:minHeight="@dimen/hn_touch_min"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@color/hypernova_cyan"
                android:textSize="@dimen/hn_text_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/now_playing_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/media_viewport"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_artwork_placeholder"
                android:minHeight="250dp">

                <ImageView
                    android:id="@+id/artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/content_description_media_artwork"
                    android:padding="@dimen/hn_space_24"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_music"
                    android:tint="@color/hypernova_cyan" />

                <TextureView
                    android:id="@+id/video_surface"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/content_description_video"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/button_fullscreen"
                    android:layout_width="@dimen/hn_touch_min"
                    android:layout_height="@dimen/hn_touch_min"
                    android:layout_gravity="top|end"
                    android:layout_margin="@dimen/hn_space_8"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/fullscreen"
                    android:padding="10dp"
                    android:src="@drawable/ic_fullscreen"
                    android:tint="@color/hypernova_icon_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/metadata_card"
                android:layout_width="match_parent"
                android:layout_height="102dp"
                android:layout_marginTop="@dimen/hn_space_8"
                android:background="@drawable/bg_content_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hn_space_16"
                android:paddingEnd="@dimen/hn_space_16">

                <TextView
                    android:id="@+id/source_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="sans-medium"
                    android:gravity="center"
                    android:minWidth="62dp"
                    android:paddingStart="@dimen/hn_space_12"
                    android:paddingEnd="@dimen/hn_space_12"
                    android:textColor="@color/hypernova_cyan"
                    android:textSize="@dimen/hn_text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hn_space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/media_title_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-medium"
                        android:maxLines="1"
                        android:textColor="@color/hypernova_text_primary"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/media_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hn_space_4"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/hypernova_text_secondary"
                        android:textSize="@dimen/hn_text_body" />

                    <TextView
                        android:id="@+id/media_tertiary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hn_space_4"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/hypernova_text_secondary"
                        android:textSize="@dimen/hn_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/progress_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/elapsed_time"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/time_unknown"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="@dimen/hn_text_secondary" />

                <SeekBar
                    android:id="@+id/media_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/hn_touch_min"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="@color/hypernova_cyan"
                    android:thumbTint="@color/hypernova_cyan" />

                <TextView
                    android:id="@+id/duration_time"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/time_unknown"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="@dimen/hn_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_previous"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/previous"
                    android:padding="14dp"
                    android:src="@drawable/ic_previous"
                    android:tint="@color/hypernova_icon_primary" />

                <ImageButton
                    android:id="@+id/button_rewind"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="@dimen/hn_space_16"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/seek_back"
                    android:padding="13dp"
                    android:src="@drawable/ic_replay_10"
                    android:tint="@color/hypernova_icon_primary" />

                <ImageButton
                    android:id="@+id/button_play_pause"
                    android:layout_width="@dimen/hn_play_button"
                    android:layout_height="@dimen/hn_play_button"
                    android:layout_marginStart="@dimen/hn_space_20"
                    android:layout_marginEnd="@dimen/hn_space_20"
                    android:background="@drawable/bg_play_button"
                    android:contentDescription="@string/play"
                    android:padding="16dp"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/button_forward"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="@dimen/hn_space_16"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/seek_forward"
                    android:padding="13dp"
                    android:src="@drawable/ic_forward_10"
                    android:tint="@color/hypernova_icon_primary" />

                <ImageButton
                    android:id="@+id/button_next"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/next"
                    android:padding="14dp"
                    android:src="@drawable/ic_next"
                    android:tint="@color/hypernova_icon_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_favorite"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="@dimen/hn_space_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_button"
                    android:fontFamily="sans-medium"
                    android:minHeight="@dimen/hn_touch_min"
                    android:text="@string/add_favorite"
                    android:textAllCaps="false"
                    android:textColor="@color/hypernova_cyan"
                    android:textSize="@dimen/hn_text_body"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/button_secondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_button"
                    android:fontFamily="sans-medium"
                    android:minHeight="@dimen/hn_touch_min"
                    android:text="@string/browse_media"
                    android:textAllCaps="false"
                    android:textColor="@color/hypernova_cyan"
                    android:textSize="@dimen/hn_text_body" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/library_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_library_back"
                    android:layout_width="@dimen/hn_touch_min"
                    android:layout_height="@dimen/hn_touch_min"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/back"
                    android:padding="10dp"
                    android:src="@drawable/ic_back"
                    android:tint="@color/hypernova_icon_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hn_space_8"
                    android:fontFamily="sans-medium"
                    android:letterSpacing="0.08"
                    android:text="@string/library"
                    android:textColor="@color/hypernova_text_primary"
                    android:textSize="18sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/library_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hypernova_text_secondary"
                    android:textSize="@dimen/hn_text_secondary" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/library_filters"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/chip_folders"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hn_touch_min"
                        android:background="@drawable/bg_chip"
                        android:minWidth="94dp"
                        android:text="@string/folders"
                        android:textAllCaps="false"
                        android:textColor="@color/hypernova_text_primary" />

                    <Button
                        android:id="@+id/chip_tracks"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hn_touch_min"
                        android:layout_marginStart="@dimen/hn_space_8"
                        android:background="@drawable/bg_chip"
                        android:minWidth="88dp"
                        android:text="@string/tracks"
                        android:textAllCaps="false"
                        android:textColor="@color/hypernova_text_primary" />

                    <Button
                        android:id="@+id/chip_artists"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hn_touch_min"
                        android:layout_marginStart="@dimen/hn_space_8"
                        android:background="@drawable/bg_chip"
                        android:minWidth="88dp"
                        android:text="@string/artists"
                        android:textAllCaps="false"
                        android:textColor="@color/hypernova_text_primary" />

                    <Button
                        android:id="@+id/chip_albums"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hn_touch_min"
                        android:layout_marginStart="@dimen/hn_space_8"
                        android:background="@drawable/bg_chip"
                        android:minWidth="88dp"
                        android:text="@string/albums"
                        android:textAllCaps="false"
                        android:textColor="@color/hypernova_text_primary" />

                    <Button
                        android:id="@+id/chip_genres"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hn_touch_min"
                        android:layout_marginStart="@dimen/hn_space_8"
                        android:background="@drawable/bg_chip"
                        android:minWidth="88dp"
                        android:text="@string/genres"
                        android:textAllCaps="false"
                        android:textColor="@color/hypernova_text_primary" />

                    <Button
                        android:id="@+id/chip_videos"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hn_touch_min"
                        android:layout_marginStart="@dimen/hn_space_8"
                        android:background="@drawable/bg_chip"
                        android:minWidth="88dp"
                        android:text="@string/videos"
                        android:textAllCaps="false"
                        android:textColor="@color/hypernova_text_primary" />

                    <Button
                        android:id="@+id/chip_queue"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hn_touch_min"
                        android:layout_marginStart="@dimen/hn_space_8"
                        android:background="@drawable/bg_chip"
                        android:minWidth="82dp"
                        android:text="@string/queue"
                        android:textAllCaps="false"
                        android:textColor="@color/hypernova_text_primary" />
                </LinearLayout>
            </HorizontalScrollView>

            <ListView
                android:id="@+id/media_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/hn_space_8"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:listSelector="@android:color/transparent"
                android:paddingBottom="@dimen/hn_space_16"
                android:scrollbars="vertical" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fullscreen_video_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hypernova_video_background"
        android:visibility="gone">

        <TextureView
            android:id="@+id/fullscreen_video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/content_description_video" />

        <ImageButton
            android:id="@+id/button_exit_fullscreen"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/hn_space_16"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/exit_fullscreen"
            android:padding="16dp"
            android:src="@drawable/ic_back"
            android:tint="@color/hypernova_icon_primary" />
    </FrameLayout>
</LinearLayout>
