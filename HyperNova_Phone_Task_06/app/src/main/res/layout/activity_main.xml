<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hn_background_primary">

    <!-- =========================================================
         HEADER
         ========================================================= -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="@color/hn_text_primary" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/cd_phone"
            android:src="@drawable/ic_phone" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hn_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxEms="18"
            android:maxLines="1"
            android:textColor="@color/hn_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>


    <!-- =========================================================
         SCREEN CONTENT
         ========================================================= -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />


    <!-- =========================================================
         PHONE INTERNAL NAVIGATION
         ========================================================= -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@id/cockpitNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navHome"
            style="@style/Widget.HyperNova.Nav"
            android:contentDescription="@string/cd_home"
            android:text="Home"
            app:icon="@drawable/ic_nav_home" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navKeypad"
            style="@style/Widget.HyperNova.Nav"
            android:contentDescription="@string/cd_keypad"
            android:text="Keypad"
            app:icon="@drawable/ic_nav_keypad" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navContacts"
            style="@style/Widget.HyperNova.Nav"
            android:contentDescription="@string/cd_contacts"
            android:text="Contacts"
            app:icon="@drawable/ic_nav_contacts" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navRecents"
            style="@style/Widget.HyperNova.Nav"
            android:contentDescription="@string/cd_recents"
            android:text="Recents"
            app:icon="@drawable/ic_nav_recents" />

    </LinearLayout>

    <include
        android:id="@+id/cockpitNavigation"
        layout="@layout/view_hypernova_cockpit_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/hn_cockpit_nav_height"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="@dimen/hn_cockpit_nav_bottom_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
