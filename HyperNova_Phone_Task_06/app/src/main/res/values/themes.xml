<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =========================================================
         HYPERNOVA PHONE — LIGHT THEME
         Default resources are used when Android/AAOS is in Day mode.
         ========================================================= -->

    <style name="Theme.HyperNovaPhone" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="android:windowActionModeOverlay">true</item>

        <!-- HyperNova Accent -->
        <item name="colorPrimary">@color/hn_primary_cyan</item>
        <item name="colorSecondary">@color/hn_primary_cyan</item>
        <item name="android:colorAccent">@color/hn_primary_cyan</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/hn_background_primary</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/hn_background_primary</item>
        <item name="android:navigationBarColor">@color/hn_background_primary</item>

        <!-- Light background requires dark system-bar icons -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Keep Android from auto-inverting our carefully themed drawables -->
        <item name="android:forceDarkAllowed">false</item>

        <!-- Material surface defaults -->
        <item name="colorSurface">@color/hn_surface_primary</item>
        <item name="colorSurfaceVariant">@color/hn_surface_secondary</item>
        <item name="colorOnSurface">@color/hn_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/hn_text_secondary</item>

    </style>

    <style name="Widget.HyperNova.Nav" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/hn_text_secondary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">2dp</item>
    </style>

</resources>
