<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!--
        Circular shape used by ShapeableImageView.

        parent="" prevents Android from treating:
        ShapeAppearanceOverlay.HyperNova
        as an implicit parent style.
    -->
    <style
        name="ShapeAppearanceOverlay.HyperNova.Circle"
        parent="">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>

    </style>

</resources>