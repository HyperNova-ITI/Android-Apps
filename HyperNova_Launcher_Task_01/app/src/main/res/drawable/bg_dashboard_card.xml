<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed state -->
    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <corners android:radius="@dimen/dashboard_card_corner_radius" />

            <gradient
                android:angle="315"
                android:startColor="@color/hypernova_selected"
                android:endColor="@color/hypernova_card" />

            <stroke
                android:width="1.5dp"
                android:color="@color/hypernova_cyan" />

        </shape>

    </item>

    <!-- Normal state -->
    <item>

        <shape android:shape="rectangle">

            <corners android:radius="@dimen/dashboard_card_corner_radius" />

            <gradient
                android:angle="315"
                android:startColor="@color/hypernova_dashboard_start"
                android:endColor="@color/hypernova_dashboard_end" />

            <stroke
                android:width="1dp"
                android:color="@color/hypernova_border" />

        </shape>

    </item>

</selector>
