<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_selected" />
            <stroke android:width="1dp" android:color="@color/hypernova_warning" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hypernova_selected" />
            <stroke android:width="1dp" android:color="@color/hypernova_cyan" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/hypernova_border_soft" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
