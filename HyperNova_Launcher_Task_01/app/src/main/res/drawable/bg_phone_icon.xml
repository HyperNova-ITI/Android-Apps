<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/hypernova_cyan_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/hypernova_cyan_bright" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">

            <solid android:color="@color/hypernova_selected" />

            <stroke
                android:width="1dp"
                android:color="@color/hypernova_cyan_bright" />

        </shape>
    </item>

</selector>
