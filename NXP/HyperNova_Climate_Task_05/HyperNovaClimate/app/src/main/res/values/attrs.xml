<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TemperatureGaugeView">
        <!-- Arc color for the filled (progress) portion. -->
        <attr name="gaugeAccentColor" format="color" />
        <!-- Arc color for the unfilled track. -->
        <attr name="gaugeTrackColor" format="color" />
        <!-- Arc stroke thickness. -->
        <attr name="gaugeStrokeWidth" format="dimension" />
    </declare-styleable>
</resources>
