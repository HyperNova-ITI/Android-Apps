<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hypernova_background"
    tools:context=".MainActivity">

    <!--
        MapLibre requires native/runtime assets and cannot be created by the
        Android Studio Layout Editor. MainActivity inserts the real MapView
        into this container at runtime; the ImageView is design-time only.
    -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/mapDesignPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:src="@drawable/navigation_map_preview"
            tools:visibility="visible" />

    </FrameLayout>

    <View
        android:id="@+id/mapScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hypernova_map_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/hn_cockpit_nav_reserved_height"
        android:orientation="vertical">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/navigation_top_bar_height"
            android:layout_marginStart="@dimen/navigation_page_margin"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/navigation_page_margin" />

        <FrameLayout
            android:id="@+id/stateHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Removed by MainActivity before it renders the real state. -->
            <include
                android:id="@+id/designPreviewHome"
                layout="@layout/panel_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="@dimen/navigation_map_control_size"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/navigation_map_control_margin_end"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoomInButton"
            style="@style/Widget.HyperNova.Button.Secondary"
            android:layout_width="@dimen/navigation_map_control_size"
            android:layout_height="@dimen/navigation_map_control_size"
            android:contentDescription="@string/map_zoom_in"
            android:minWidth="@dimen/navigation_map_control_size"
            android:padding="0dp"
            android:text="@string/map_zoom_in_symbol"
            android:textSize="26sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoomOutButton"
            style="@style/Widget.HyperNova.Button.Secondary"
            android:layout_width="@dimen/navigation_map_control_size"
            android:layout_height="@dimen/navigation_map_control_size"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/map_zoom_out"
            android:minWidth="@dimen/navigation_map_control_size"
            android:padding="0dp"
            android:text="@string/map_zoom_out_symbol"
            android:textSize="26sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/centerOriginButton"
            style="@style/Widget.HyperNova.Button.Secondary"
            android:layout_width="@dimen/navigation_map_control_size"
            android:layout_height="@dimen/navigation_map_control_size"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/map_center_origin"
            android:minWidth="@dimen/navigation_map_control_size"
            android:padding="0dp"
            android:text=""
            app:icon="@drawable/ic_navigation"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/hypernova_cyan" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapStateCard"
        style="@style/Widget.HyperNova.Card"
        android:layout_width="@dimen/navigation_map_state_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/mapLoadingIndicator"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="@color/hypernova_cyan" />

            <ImageView
                android:id="@+id/mapErrorIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_error"
                android:visibility="gone"
                app:tint="@color/hypernova_error" />

            <TextView
                android:id="@+id/mapStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/map_loading_title"
                android:textColor="@color/hypernova_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mapStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/map_loading_message"
                android:textColor="@color/hypernova_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapRetryButton"
                style="@style/Widget.HyperNova.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="@string/retry"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/cockpitNavigation"
        layout="@layout/view_hypernova_cockpit_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hn_cockpit_nav_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="@dimen/hn_cockpit_nav_bottom_margin" />

</FrameLayout>
