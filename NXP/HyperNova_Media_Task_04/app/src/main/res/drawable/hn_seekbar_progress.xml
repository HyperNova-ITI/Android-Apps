<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@android:id/background"
        android:height="7dp"
        android:gravity="center_vertical">

        <shape android:shape="rectangle">
            <corners android:radius="999dp" />

            <solid android:color="#142934" />

            <stroke
                android:width="1dp"
                android:color="#294754" />
        </shape>
    </item>

    <item
        android:id="@android:id/secondaryProgress"
        android:height="7dp"
        android:gravity="center_vertical">

        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />

                <solid android:color="#365E6D" />
            </shape>
        </clip>
    </item>

    <item
        android:id="@android:id/progress"
        android:height="7dp"
        android:gravity="center_vertical">

        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />

                <gradient
                    android:angle="0"
                    android:startColor="#00BBD4"
                    android:centerColor="#14DDF2"
                    android:endColor="#71F4FF" />
            </shape>
        </clip>
    </item>

</layer-list>
