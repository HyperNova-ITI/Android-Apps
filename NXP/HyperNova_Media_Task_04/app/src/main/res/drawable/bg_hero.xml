<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
        Uses HyperNova theme colors instead of hardcoded dark colors.

        Light Mode:
            light premium surface

        Dark Mode:
            the same resource automatically resolves to values-night
            and becomes a dark HyperNova surface.
    -->
    <gradient
        android:angle="315"
        android:startColor="@color/hn_surface_high"
        android:centerColor="@color/hn_surface"
        android:endColor="@color/hn_background_deep" />

    <corners android:radius="@dimen/hn_card_radius" />

</shape>
