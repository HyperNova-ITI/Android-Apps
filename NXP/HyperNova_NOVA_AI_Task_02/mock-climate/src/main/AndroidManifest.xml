<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="HyperNova Climate Mock"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ClimateMockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.hypernova.climate.action.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ClimateCommandService"
            android:exported="true"
            android:permission="com.hypernova.permission.CONTROL_COCKPIT_APPS">
            <intent-filter>
                <action android:name="com.hypernova.climate.action.BIND_COMMAND" />
            </intent-filter>
        </service>

    </application>

</manifest>
