<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer cyan glow -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:centerColor="@color/hypernova_orb_cyan_center"
                android:endColor="@color/hypernova_orb_cyan_edge" />

            <stroke
                android:width="2dp"
                android:color="@color/hypernova_cyan" />

        </shape>

    </item>

    <!-- Purple middle ring -->
    <item
        android:left="34dp"
        android:top="34dp"
        android:right="34dp"
        android:bottom="34dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="75dp"
                android:centerColor="@color/hypernova_orb_purple_center"
                android:endColor="@color/hypernova_orb_purple_edge" />

            <stroke
                android:width="2dp"
                android:color="@color/hypernova_purple" />

        </shape>

    </item>

    <!-- Bright center -->
    <item
        android:left="70dp"
        android:top="70dp"
        android:right="70dp"
        android:bottom="70dp">

        <shape android:shape="oval">

            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:startColor="@color/hypernova_orb_center_highlight"
                android:centerColor="@color/hypernova_cyan"
                android:endColor="@color/hypernova_cyan_dark" />

        </shape>

    </item>

</layer-list>
