<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>

        <shape android:shape="oval">

            <solid android:color="@color/hypernova_nav_selected_outer_fill" />

            <stroke
                android:width="1dp"
                android:color="@color/hypernova_nav_selected_outer_stroke" />

        </shape>

    </item>

    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">

        <shape android:shape="oval">

            <gradient
                android:angle="270"
                android:startColor="@color/hypernova_nav_selected_inner_start"
                android:endColor="@color/hypernova_nav_selected_inner_end" />

            <stroke
                android:width="1dp"
                android:color="@color/hypernova_nav_selected_inner_stroke" />

        </shape>

    </item>

</layer-list>
