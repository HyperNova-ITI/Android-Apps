<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hn_cockpit_selected_outer_fill" />
            <stroke android:width="1dp" android:color="@color/hn_cockpit_selected_outer_stroke" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/hn_cockpit_selected_inner_start" android:endColor="@color/hn_cockpit_selected_inner_end" />
            <stroke android:width="1dp" android:color="@color/hn_cockpit_selected_inner_stroke" />
        </shape>
    </item>
</layer-list>
