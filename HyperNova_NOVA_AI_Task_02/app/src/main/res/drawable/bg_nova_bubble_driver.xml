<?xml version="1.0" encoding="utf-8"?>
<!-- What the driver said. Filled rather than gradient, so the driver's own words are the quieter
     of the two and NOVA's answer stays the focus. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/hypernova_selected" />
    <stroke
        android:width="1dp"
        android:color="@color/hypernova_border_soft" />
    <corners
        android:bottomLeftRadius="18dp"
        android:bottomRightRadius="6dp"
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp" />
</shape>
