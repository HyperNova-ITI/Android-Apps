<?xml version="1.0" encoding="utf-8"?>
<!-- A blocked action or an active vehicle fault. Same shape as a normal NOVA reply so the layout
     never jumps; only the border carries the severity. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="@color/hypernova_dashboard_start"
        android:endColor="@color/hypernova_dashboard_end" />
    <stroke
        android:width="1dp"
        android:color="@color/hypernova_error" />
    <corners
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="18dp"
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp" />
</shape>
